{
  "contract": "adcs.extraction.v1",
  "plugin_id": "aspose.words.net",
  "version": "0.1.0",
  "product_id": "aspose.words",
  "language": "net",
  "title": "Aspose.Words for .NET",
  "worker": [
    "{python}",
    "-I",
    "{plugin_dir}/worker.py"
  ],
  "sources": {
    "docs": {
      "repo_id": "aspose.words.net.docs",
      "path": "sources/documentation-current",
      "prefix": "en/net",
      "layout": {
        "layout_type": "doc_locale/programming_language/content"
      },
      "canonical_base_url": "https://docs.aspose.com/words/net",
      "url": "https://github.com/sabir-aspose/words-docs-com.git",
      "branch": "master"
    },
    "apiref": {
      "repo_id": "aspose.words.net.apiref",
      "path": "sources/api-reference",
      "prefix": "english/net",
      "layout": {
        "layout_type": "doc_locale/programming_language/namespace"
      },
      "canonical_base_url": "https://reference.aspose.com/words/net",
      "url": "https://github.com/aspose-words/Aspose.Words-API-References.git",
      "branch": "main"
    }
  },
  "retrieval_profile": "retrieval-profile.json"
}
